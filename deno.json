{
  "imports": {
    "@/": "./",
    "preact": "npm:preact@^10",
    "preact-render-to-string": "npm:preact-render-to-string@^6",
    "zod": "npm:zod@^4",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1",
    "@std/http": "jsr:@std/http@^1"
  },
  "tasks": {
    "dev": "OTEL_DENO=true deno watch --allow-all --unstable-kv app/main.tsx"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "lint": {
    "rules": {
      "exclude": ["no-namespace"]
    }
  }
}
