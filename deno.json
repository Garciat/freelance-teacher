{
  "imports": {
    "@/": "./",
    "esbuild": "npm:esbuild",
    "react": "npm:react@^19",
    "react-dom": "npm:react-dom@^19",
    "@types/react": "npm:@types/react@^19",
    "@react-pdf/renderer": "npm:@react-pdf/renderer@^4",
    "zod": "npm:zod@^4",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1",
    "@std/http": "jsr:@std/http@^1"
  },
  "tasks": {
    "dev": "OTEL_DENO=true deno watch --allow-all --unstable-kv app/main.tsx"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "lint": {
    "rules": {
      "exclude": ["no-namespace"]
    }
  }
}
